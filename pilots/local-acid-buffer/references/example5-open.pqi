# USGS PHREEQC Example 5, 3.8.6-17100 distribution examples/ex5.
# Reaction/equilibrium inputs unchanged; graph omitted, output instrumented.
TITLE Example 5 -- atmospheric carbon reference, not the transient pilot
SOLUTION 1 PURE WATER
 pH 7.0
 temp 25.0
EQUILIBRIUM_PHASES 1
 Pyrite 0.0
 Goethite 0.0
 Calcite 0.0
 CO2(g) -3.5
 Gypsum 0.0 0.0
REACTION 1
 O2 1.0
 NaCl 0.5
 0.0 0.001 0.005 0.01 0.03 0.05
SELECTED_OUTPUT
 -file selected.tsv
 -reset false
 -high_precision true
USER_PUNCH
 -headings reactionO2 pH waterKg carbon calcite pyrite goethite gypsum gasCarbon gypsumSI
 10 PUNCH RXN, -LA("H+"), TOT("water"), TOTMOLE("C"), EQUI("Calcite"), EQUI("Pyrite"), EQUI("Goethite"), EQUI("Gypsum"), EQUI("CO2(g)"), SI("Gypsum")
END
